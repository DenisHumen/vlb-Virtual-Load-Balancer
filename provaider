#!/usr/bin/env bash
# change_gateway.sh — установить статический шлюз по умолчанию через netplan (renderer: networkd)
# Запускать на сервере как root (или через sudo).
#
# Использование:
#   sudo ./change_gateway.sh <NEW_GATEWAY> [INTERFACE]
# Пример:
#   sudo ./change_gateway.sh 10.0.0.1
#   sudo ./change_gateway.sh 10.0.0.1 enp5s0
#
# Что делает:
#   1. Бэкапит /etc/netplan -> /etc/netplan.backup.<timestamp>
#   2. Отключает управление сетью со стороны cloud-init
#   3. Автоматически определяет основной ethernet-интерфейс (или берёт из аргумента)
#   4. Считывает текущий IP/маску этого интерфейса
#   5. Удаляет все существующие .yaml в /etc/netplan
#   6. Создаёт единственный /etc/netplan/00-static.yaml со статической конфигурацией
#      (renderer: networkd, статический IP, шлюз = NEW_GATEWAY, DNS 8.8.8.8 / 1.1.1.1)
#   7. Применяет конфигурацию (netplan generate + netplan apply)
#   8. На лету подменяет default route — чтобы не зависеть от lease
#   9. Печатает итоговую таблицу маршрутов

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "Скрипт должен запускаться от root (sudo)." >&2
    exit 1
fi

NEW_GW="${1:-}"
IFACE_ARG="${2:-}"

if [[ -z "$NEW_GW" ]]; then
    echo "Использование: $0 <NEW_GATEWAY> [INTERFACE]" >&2
    exit 1
fi

# базовая валидация IP
if ! [[ "$NEW_GW" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    echo "Некорректный IP шлюза: $NEW_GW" >&2
    exit 1
fi

ts="$(date +%Y%m%d-%H%M%S)"
BACKUP_DIR="/etc/netplan.backup.${ts}"

echo "[*] Бэкап текущих настроек netplan -> ${BACKUP_DIR}"
cp -a /etc/netplan "${BACKUP_DIR}"

# 1) Определяем интерфейс
if [[ -n "$IFACE_ARG" ]]; then
    IFACE="$IFACE_ARG"
else
    # берём интерфейс, через который сейчас идёт default route
    IFACE="$(ip -o -4 route show to default | awk '{print $5; exit}')"
    if [[ -z "$IFACE" ]]; then
        # запасной вариант: первый UP ethernet (НЕ lo, НЕ wireless)
        IFACE="$(ip -o link show up | awk -F': ' '{print $2}' | grep -E '^(en|eth)' | head -n1)"
    fi
fi

if [[ -z "$IFACE" ]] || ! ip link show "$IFACE" >/dev/null 2>&1; then
    echo "Не удалось определить активный интерфейс. Передайте его вторым аргументом." >&2
    exit 1
fi
echo "[*] Используем интерфейс: ${IFACE}"

# 2) Текущий IP/маска
CIDR="$(ip -o -4 addr show dev "$IFACE" | awk '{print $4; exit}')"
if [[ -z "$CIDR" ]]; then
    echo "Нет IPv4-адреса на ${IFACE}." >&2
    exit 1
fi
echo "[*] Текущий адрес ${IFACE}: ${CIDR}"

# 3) Отключаем cloud-init network config (иначе 50-cloud-init.yaml пересоздастся при ребуте)
mkdir -p /etc/cloud/cloud.cfg.d
cat >/etc/cloud/cloud.cfg.d/99-disable-network-config.cfg <<'EOF'
network: {config: disabled}
EOF
echo "[*] Cloud-init network management отключён."

# 4) Чистим /etc/netplan
shopt -s nullglob
for f in /etc/netplan/*.yaml /etc/netplan/*.yml; do
    rm -f "$f"
done
shopt -u nullglob

# 5) Пишем единственный конфиг
NETPLAN_FILE="/etc/netplan/00-static.yaml"
cat >"${NETPLAN_FILE}" <<EOF
network:
  version: 2
  renderer: networkd
  ethernets:
    ${IFACE}:
      dhcp4: false
      dhcp6: false
      addresses:
        - ${CIDR}
      routes:
        - to: default
          via: ${NEW_GW}
      nameservers:
        addresses:
          - 8.8.8.8
          - 1.1.1.1
EOF
chmod 600 "${NETPLAN_FILE}"
echo "[*] Записан ${NETPLAN_FILE}:"
sed 's/^/    /' "${NETPLAN_FILE}"

# 6) Применяем
echo "[*] netplan generate"
netplan generate
echo "[*] netplan apply"
netplan apply

# 7) Подменяем default route немедленно (на случай, если networkd ещё не подхватил)
ip route replace default via "${NEW_GW}" dev "${IFACE}" || true

# 8) Удаляем устаревший default через старый шлюз, если остался
ip -4 route show default | awk '{print $0}' | while read -r line; do
    via=$(echo "$line" | awk '{for(i=1;i<=NF;i++) if($i=="via") print $(i+1)}')
    if [[ -n "$via" && "$via" != "$NEW_GW" ]]; then
        echo "[*] Удаляю старый default via ${via}"
        ip route del default via "$via" 2>/dev/null || true
    fi
done

echo
echo "=== Итоговые маршруты ==="
ip -4 route show
echo
echo "=== Default ==="
ip -4 route show default
echo
echo "[OK] Готово. Бэкап старых настроек: ${BACKUP_DIR}"
